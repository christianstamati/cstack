{
  "name": "@cstack-dev/town",
  "version": "0.2.0",
  "description": "Build your stack as a little 3D town with Claude Code or Codex",
  "keywords": [
    "claude-code",
    "cli",
    "codex",
    "create",
    "scaffold",
    "typescript"
  ],
  "homepage": "https://github.com/christianstamati/cstack#readme",
  "bugs": {
    "url": "https://github.com/christianstamati/cstack/issues"
  },
  "author": "Christian Stamati",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianstamati/cstack.git"
  },
  "bin": {
    "town": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && vp run build:ui",
    "build:ui": "vp build ui",
    "check": "vp check",
    "test": "vp test",
    "sync-prompt": "bun scripts/sync-prompt.ts",
    "ready": "vp check && vp test && vp run build",
    "prepublishOnly": "vp check && vp test && vp run build && bun scripts/check-pack-size.ts",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@react-three/fiber": "^9.8.2",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "three": "^0.186.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "bun@1.4.3"
}
