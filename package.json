{
  "name": "cstack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "create-cstack-app": "cli/src/index.ts"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli"
  ],
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "typecheck": "vp run -r --cache typecheck",
    "test": "vp run -r --cache test",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "ci": "vp check && vp run typecheck && vp run test",
    "ui:add": "cd apps/web && bunx shadcn@latest add",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; vp config --no-agent"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
